index 0000000..cf34e8d
--- /dev/null
+++ b/dm/linux/bin/xcrun
@@ -0,0 +1,195 @@
+#!/usr/bin/env python3
+# xcrun for Linux and Windows: only what the shader chain asks of it (dmsh_build.py, ios_metal.py, dmsh_chain.py), `xcrun -sdk <macosx|iphoneos> <metal|metallib> ...`, run by Apple's
+# Metal Developer Tools for Windows: under wine on Linux, natively on Windows (where nxnativev2's xcrun.exe runs this script with the bundled Python). The NSP script puts
+# dm/linux/bin first in PATH on Linux (dm/linux/README.md).
+#   DM_METAL_WIN = the tools' install folder (default: "Metal Developer Tools" under the wine prefix's Program Files); the compiler is <folder>/<ios|macos>/bin/metal.exe
+#   (or <folder>/bin/metal.exe; version 6 has its compiler in <folder>/metal/<version>/bin), metallib.exe beside it. WINEPREFIX picks the prefix as for wine itself.
+# The Windows tools take the same options as the Mac's, but the target triple is given with -target (air64-apple-ios<min> / air64-apple-macos<min>), not by the SDK:
+# -mios-version-min=X becomes -target air64-apple-iosX. Absolute paths are passed as Z: paths (wine maps / to Z:).
+# One compile per source: dmsh_build.py compiles each shader for the Mac host and then the same source for iOS. On Linux there is no Mac host and the IPA takes only the
+# iOS libraries, so a Mac `metal -c` is compiled as the iOS compile of that source (ios_metal.py's flags) and its result kept in a memo, which the iOS request that follows
+# takes (and removes); `metallib` the same, keyed by the AIR. The iOS outputs are what the compiler makes of those flags either way (it is deterministic); the Mac outputs are
+# iOS ones, which nothing on Linux loads. A Mac request whose iOS twin never comes costs what it did. DM_XCRUN_MAC=1 compiles Mac requests for the Mac.
+# A compile that failed is remembered (xcrun_failed beside the memo, keyed by the tool, flags, input and the compiler file itself): the build tries the same failing
+# sources on every run (fetch variants that do not compile are never cached), and the answer is the same error at once.
+# DM_XCRUN_DEFER=1 (shaders compiled on the device): `metal -c` writes the source behind DEFER_MAGIC instead of compiling, `metallib` of one such input passes it on
+# (the host compiles it at run time, nvn_mtl.m lib_from_file), and `metal --version` says so, which keeps such libraries apart in every cache keyed by the compiler.
+import glob, hashlib, os, random, shutil, subprocess, sys, tempfile, time
+
+MAC_MIN = '15.0'   # xcrun -sdk macosx metal with no minimum targets the running macOS; the Mac libraries are never packed into the IPA
+MAC_FLAGS = ['-c', '-fpreserve-invariance']   # dmsh_build.py's MAC_METAL after `metal`
+DEFER_MAGIC = b'//DMMSL1 deferred: compiled on the device\n'
+DEFER = bool(os.environ.get('DM_XCRUN_DEFER'))
+
+
+def die(msg):
+    sys.exit(f'xcrun (dm/linux): {msg}')
+
+
+def tools_root():
+    if os.environ.get('DM_METAL_WIN'): return os.environ['DM_METAL_WIN']
+    prefix = os.environ.get('WINEPREFIX') or os.path.expanduser('~/.wine')
+    for pf in ('Program Files', 'Program Files (x86)'):
+        d = os.path.join(prefix, 'drive_c', pf, 'Metal Developer Tools')
+        if os.path.isdir(d): return d
+    die('no Metal Developer Tools for Windows: install them with wine (developer.apple.com/download/all, "Metal Developer Tools for Windows"), or set DM_METAL_WIN')
+
+
+def exe(sdk, tool):   # the compiler itself (6.x: metal/<version>/bin) before bin/'s launcher of it, which costs 4 s a call under wine
+    root = tools_root()
+    inner = sorted(glob.glob(os.path.join(root, 'metal', '*', 'bin')))
+    for d in inner[-1:] + [os.path.join(root, 'ios' if sdk == 'iphoneos' else 'macos', 'bin'), os.path.join(root, 'bin')]:
+        p = os.path.join(d, tool + '.exe')
+        if os.path.isfile(p): return p
+    die(f'no {tool}.exe for {sdk} under {root}')
+
+
+NATIVE = os.name == 'nt'   # Windows runs the tools itself; elsewhere wine does
+
+
+def win(a):   # an absolute Unix path → its Z: path (on Windows, paths are the tools' own already)
+    if NATIVE: return a
+    return 'Z:' + a.replace('/', '\\') if a.startswith('/') else a
+
+
+def launch(exe_path):   # the command line that runs a Windows tool here
+    return [exe_path] if NATIVE else ['wine', exe_path]
+
+
+def tool_run(cmd, env):   # → CompletedProcess with stdout / stderr as bytes, through temporary files, never pipes: wine's server and services start with the first Windows
+    # program and inherit its handles, and a pipe they hold stays open after the program ends (a caller reading one to its end waited 3 to 5 s a call: the three version checks
+    # at a shader build's start took 15 s; with a server kept running, forever)
+    with tempfile.TemporaryFile() as o, tempfile.TemporaryFile() as e:
+        rc = subprocess.run(cmd, env=env, stdin=subprocess.DEVNULL, stdout=o, stderr=e).returncode
+        o.seek(0); e.seek(0)
+        return subprocess.CompletedProcess(cmd, rc, o.read(), e.read())
+
+
+def run(sdk, tool, args, capture=False):   # capture: stderr returned in the result, else passed on; stdout is always passed on
+    out = []
+    if tool == 'metal' and '--version' not in args:
+        mn = next((x.split('=', 1)[1] for x in args if x.startswith('-mios-version-min=')), None)
+        args = [x for x in args if not x.startswith('-mios-version-min=')]
+        out += ['-target', f'air64-apple-ios{mn or "18.0"}' if sdk == 'iphoneos' else f'air64-apple-macos{MAC_MIN}']
+    out += [win(x) for x in args]
+    env = dict(os.environ, WINEDEBUG=os.environ.get('WINEDEBUG', '-all'))
+    r = tool_run([*launch(exe(sdk, tool)), *out], env)
+    sys.stdout.buffer.write(r.stdout); sys.stdout.flush()
+    if not capture: sys.stderr.buffer.write(r.stderr); sys.stderr.flush()
+    return r
+
+
+def ios_flags():   # what ios_metal.py passes after `metal` (None when it cannot be read: no memo)
+    try:
+        sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '../../ios/tools')); import ios_metal
+        return ios_metal.METAL[ios_metal.METAL.index('metal') + 1:]
+    except Exception: return None
+
+
+def split_io(args):   # → (flags, inputs, output) of `metal -c <flags> <inputs> -o <output>` / `metallib <inputs> -o <output>`, or None
+    if args.count('-o') != 1 or args.index('-o') + 1 >= len(args): return None
+    i = args.index('-o'); rest = args[:i] + args[i + 2:]
+    ins = [x for x in rest if os.path.isabs(x) and os.path.isfile(x)]
+    return ([x for x in rest if x not in ins], ins, args[i + 1]) if ins else None
+
+
+def memo_dir():
+    d = os.path.join(os.environ.get('WORK') or tempfile.gettempdir(), 'xcrun_memo'); os.makedirs(d, exist_ok=True)
+    if random.random() < 0.01:   # what a Mac request left without its iOS twin (a stopped build) goes after a day
+        for f in os.listdir(d):
+            try:
+                if time.time() - os.path.getmtime(os.path.join(d, f)) > 86400: os.unlink(os.path.join(d, f))
+            except OSError: pass
+    return d
+
+
+def take(m, dst):   # the memo's file to its destination (moved: each memo answers one request)
+    try: os.replace(m, dst)
+    except OSError: shutil.copyfile(m, dst); os.unlink(m)
+
+
+def compiler_key(sdk, tool):   # the compiler file itself: replacing or realigning it forgets its failures
+    p = exe(sdk, tool); st = os.stat(p)
+    return f'{os.path.realpath(p)}\0{st.st_size}\0{st.st_mtime_ns}'
+
+
+def run_cached(sdk, tool, args):   # → (exit code, stderr); a failure seen before is answered from xcrun_failed
+    io = split_io(args)
+    key = None
+    if io is not None:
+        flags, ins, _ = io
+        h = hashlib.sha256('\0'.join([compiler_key(sdk, tool), sdk, tool, *flags]).encode())
+        for x in ins: h.update(b'\0' + open(x, 'rb').read())
+        key = os.path.join(os.environ.get('DM_XCRUN_FAILED') or os.path.join(os.path.dirname(memo_dir()), 'xcrun_failed'), h.hexdigest())   # DM_XCRUN_FAILED: kept between builds
+        if os.path.exists(key):
+            e = open(key, 'rb').read(); return (e[0] or 1), e[1:]
+    r = run(sdk, tool, args, capture=True)
+    if r.returncode and key:
+        os.makedirs(os.path.dirname(key), exist_ok=True)
+        tmp = f'{key}.{os.getpid()}'; open(tmp, 'wb').write(bytes([min(r.returncode, 255)]) + r.stderr); os.replace(tmp, key)
+    return r.returncode, r.stderr
+
+
+def defer(sdk, tool, args):   # DM_XCRUN_DEFER: the request without the compiler; None when it needs the compiler
+    if tool == 'metal' and '--version' in args:
+        r = tool_run([*launch(exe(sdk, tool)), '--version'], dict(os.environ, WINEDEBUG=os.environ.get('WINEDEBUG', '-all')))
+        sys.stdout.buffer.write(r.stdout + b'deferred: shaders compiled on the device (DM_XCRUN_DEFER)\n'); return r.returncode
+    io = split_io(args)
+    if io is None: return None
+    flags, ins, dst = io
+    if tool == 'metal' and '-c' in args and len(ins) == 1:   # the source, after the marker and a comment with the request (for a later real compile)
+        with open(dst, 'wb') as f: f.write(DEFER_MAGIC + ('//DMMSL-REQUEST ' + '\t'.join([sdk, *flags]) + '\n').encode() + open(ins[0], 'rb').read())
+        return 0
+    if tool == 'metallib':
+        heads = [open(x, 'rb').read(len(DEFER_MAGIC)) == DEFER_MAGIC for x in ins]
+        if len(ins) == 1 and heads[0]: shutil.copyfile(ins[0], dst); return 0
+        # several inputs to link into one library: the deferred ones are compiled now (a library of several sources cannot be compiled from one text)
+        for x, d in zip(ins, heads):
+            if d:
+                body = open(x, 'rb').read()[len(DEFER_MAGIC):]
+                req, _, body = body.partition(b'\n')
+                parts = req.decode().removeprefix('//DMMSL-REQUEST ').split('\t')
+                src = x + '.metal'
+                with open(src, 'wb') as f: f.write(body)
+                rc, err = run_cached(parts[0], 'metal', [*parts[1:], src, '-o', x])
+                sys.stderr.buffer.write(err)
+                if rc: return rc
+        return None
+    return None
+
+
+def memo(sdk, tool, args):   # the request through the memo; None when it does not apply
+    io = split_io(args)
+    if io is None or os.environ.get('DM_XCRUN_MAC') or (tool == 'metal' and '-c' not in args): return None
+    flags, ins, dst = io
+    mac = sdk == 'macosx'
+    if tool == 'metal':   # only dmsh_build.py's pair: its Mac flags (MAC_METAL) and ios_metal.py's
+        ios = ios_flags()
+        if ios is None or len(ins) != 1 or flags != (MAC_FLAGS if mac else ios): return None
+        flags = ios
+    k = hashlib.sha256('\0'.join([tool, *flags]).encode() + b'\0' + b''.join(open(x, 'rb').read() for x in ins)).hexdigest()
+    m = os.path.join(memo_dir(), k)
+    if not mac:   # the iOS request: the Mac request's result, if it is there
+        if os.path.exists(m + '.out'): take(m + '.out', dst); return 0
+        if os.path.exists(m + '.err'):
+            e = open(m + '.err', 'rb').read(); os.unlink(m + '.err'); sys.stderr.buffer.write(e[1:]); return e[0] or 1
+        return None
+    rc, err = run_cached('iphoneos', tool, [*flags, *ins, '-o', dst])   # the Mac request, compiled as the iOS one; kept for it
+    sys.stderr.buffer.write(err)
+    tmp = f'{m}.{os.getpid()}'
+    if rc == 0 and os.path.exists(dst): shutil.copyfile(dst, tmp); os.replace(tmp, m + '.out')
+    elif rc: open(tmp, 'wb').write(bytes([min(rc, 255)]) + err); os.replace(tmp, m + '.err')
+    return rc
+
+
+a = sys.argv[1:]
+sdk = 'macosx'
+if a[:1] == ['-sdk'] and len(a) > 1: sdk, a = a[1], a[2:]
+if sdk not in ('macosx', 'iphoneos'): die(f'unsupported SDK {sdk}')
+if not a or a[0] not in ('metal', 'metallib'): die(f'only metal and metallib are supported, not {" ".join(a[:1])}')
+tool, args = a[0], a[1:]
+rc = defer(sdk, tool, args) if DEFER else None
+if rc is None: rc = memo(sdk, tool, args)
+if rc is None and '--version' not in args and split_io(args) is not None:
+    rc, err = run_cached(sdk, tool, args); sys.stderr.buffer.write(err)
+sys.exit(rc if rc is not None else run(sdk, tool, args).returncode)
