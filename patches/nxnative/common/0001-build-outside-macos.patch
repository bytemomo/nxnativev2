+# (its letters: macOS's Arial Rounded Bold, on Linux Noto Sans Bold or DejaVu Sans Bold unless LETTER_FONT names a TTF)
+if [ -z "${LETTER_FONT:-}" ] && [ "$LINUX" = YES ]; then for f in /usr/share/fonts/noto/NotoSans-Bold.ttf /usr/share/fonts/truetype/noto/NotoSans-Bold.ttf /usr/share/fonts/TTF/DejaVuSans-Bold.ttf /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf; do
