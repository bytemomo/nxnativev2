+#!/usr/bin/env python3
+# gen_build.py without make and without symlinks (Linux, Windows): the same Gen/src, Gen/main/main.c and xcconfig lines, from dm/host/Makefile's own
+# variables, evaluated here instead of by `make -n -B dmhost`. It understands what that Makefile uses: assignments (= and :=), $(VAR), $(sort …),
+# $(wildcard …), $(shell find DIR -name 'PAT'), $(dir …), and the recipe lines of dmhost (the host's compile line: -I, -D, -framework, sources) and of the
+# libvpx objects (their -I). The game profile header is written by game.py as the Makefile's game_profile target does. Files are linked into Gen/src
+# where symlinks work, else copied.
+# Usage: gen_build_portable.py <dm/host dir> <Gen dir>   (GAME from the environment, as for gen_build.py)
+import fnmatch, glob, os, re, shlex, shutil, subprocess, sys
+
+host, gen = os.path.abspath(sys.argv[1]), os.path.abspath(sys.argv[2])
+game = os.environ.get('GAME') or sys.exit('GAME is not set')
+games_py = os.path.normpath(os.path.join(host, '../games/game.py'))
+
+# the profile folder: dm/games/<id> unless DM_GAMES_FIRST asks for another one (DM_GAMES_DIR), as the Makefile's GAME_DIR
+in_repo = os.path.join(host, '../games', game)
+if os.path.isfile(os.path.join(in_repo, 'game.tsv')) and not os.environ.get('DM_GAMES_FIRST'):
+    game_dir = os.path.normpath(in_repo)
+else:
+    game_dir = subprocess.run([sys.executable, games_py, 'dir', game], capture_output=True, text=True, check=True).stdout.strip()
+game_h = os.path.join(host, 'gen', game, 'game_profile.h')
+os.makedirs(os.path.dirname(game_h), exist_ok=True)
+subprocess.run([sys.executable, games_py, 'header', game, game_h], check=True, cwd=host)   # the Makefile's game_profile target
+
+text = open(os.path.join(host, 'Makefile')).read().replace('\\\n', ' ')
+# every path this evaluator produces uses /: the compile lines are split with shlex, which takes Windows' \ for escapes
+slash = lambda p: p.replace(os.sep, '/')
+variables = {'GAME': game, 'GAME_DIR': slash(game_dir), 'GAME_H': slash(game_h)}
+fixed = set(variables)
+for m in re.finditer(r'^([A-Z_][A-Z0-9_]*)\s*:?=\s*(.*?)\s*(?:#.*)?$', text, re.M):
+    if m.group(1) not in fixed:   # GAME, GAME_DIR, GAME_H are this script's (absolute paths)
+        variables[m.group(1)] = m.group(2)
+
+
+def split_args(s):   # function arguments: commas at nesting level 0
+    out, depth, cur = [], 0, ''
+    for c in s:
+        if c == '(':
+            depth += 1
+        elif c == ')':
+            depth -= 1
+        if c == ',' and depth == 0:
+            out.append(cur); cur = ''
+        else:
+            cur += c
+    return out + [cur]
+
+
+def expand(s, depth=0):
+    if depth > 20: return s
+    out, i = '', 0
+    while i < len(s):
+        if s.startswith('$(', i):
+            j, level = i + 2, 1
+            while j < len(s) and level:
+                level += {'(': 1, ')': -1}.get(s[j], 0); j += 1
+            inner = s[i + 2:j - 1]
+            name, _, rest = inner.partition(' ')
+            if name == 'sort':
+                out += ' '.join(sorted(set(expand(rest, depth + 1).split())))
+            elif name == 'wildcard':
+                found = []
+                for pat in expand(rest, depth + 1).split():
+                    found += sorted(slash(os.path.relpath(p, host) if not os.path.isabs(pat) else p) for p in glob.glob(os.path.join(host, pat)))
+                out += ' '.join(found)
+            elif name == 'dir':
+                out += ' '.join(slash(os.path.dirname(w)) + '/' for w in expand(rest, depth + 1).split())
+            elif name == 'shell':
+                cmd = shlex.split(expand(rest, depth + 1))
+                if cmd[:1] == ['find'] and '-name' in cmd:
+                    root, pat = cmd[1], cmd[cmd.index('-name') + 1]
+                    hits = []
+                    for d, _, fs in os.walk(os.path.join(host, root)):
+                        hits += [slash(os.path.relpath(os.path.join(d, f), host)) for f in fs if fnmatch.fnmatch(f, pat)]
+                    out += ' '.join(sorted(hits))
+            elif name in ('if', 'and', 'patsubst', 'filter-out', 'or', 'strip', 'error'):
+                out += ''   # not needed for the compile list
+            else:
+                out += expand(variables.get(inner, ''), depth + 1)
+            i = j
+        else:
+            out += s[i]; i += 1
+    return out
+
+
+def recipe(target_re):   # the compile line (tab-indented, running clang) of the rule whose target matches
+    lines = text.split('\n')
+    for k, l in enumerate(lines):
+        if re.match(target_re, l):
+            for r in lines[k + 1:]:
+                if not r.startswith('\t'): break
+                r = r.lstrip('\t').lstrip('@')
+                if r.startswith('clang'): return r
+    sys.exit(f'no clang recipe for {target_re} in {host}/Makefile')
+
+
+link = shlex.split(expand(recipe(r'^dmhost:\s')))
+vpx_compile = shlex.split(expand(recipe(r'^gen/vpx/%\.o:')))
+vpx_sources = expand('$(VPX_SRC)').split()
+
+# as gen_build.py: the host's own line first (its header paths first), then the libvpx compiles
+srcs, incs, defs, fws = [], [], [], []
+for toks, extra in ((link, []), (vpx_compile, vpx_sources)):
+    i = 0
+    while i < len(toks):
+        t = toks[i]
+        if t == '-framework': fws.append(toks[i + 1]); i += 2; continue
+        if t.startswith('-I'):
+            d = os.path.normpath(os.path.join(host, t[2:]))
+            if d not in incs: incs.append(d)
+        elif t.startswith('-D'): defs.append(t)
+        elif t.endswith(('.c', '.m', '.S')) and not t.startswith('$'): srcs.append(os.path.normpath(os.path.join(host, t)))
+        i += 1
+    srcs += [os.path.normpath(os.path.join(host, s)) for s in extra]
+assert srcs, 'no source files in the compile command'
+dup = sorted({s for s in srcs if srcs.count(s) > 1})
+if dup: sys.exit('duplicate source files in the compile command: ' + ' '.join(dup))
+
+
+def place(src, dst):   # a symlink where possible (follows edits), else a copy (Windows without the privilege)
+    try: os.symlink(src, dst)
+    except (OSError, NotImplementedError): shutil.copyfile(src, dst)
+
+
+os.makedirs(f'{gen}/src'); os.makedirs(f'{gen}/main')
+dirs = []
+ios_sources = os.path.normpath(os.path.join(host, '../ios/Sources'))
+for s in srcs:
+    d = os.path.dirname(s)
+    if d not in dirs: dirs.append(d)
+    b = os.path.basename(s)
+    if os.path.splitext(b)[0].endswith('_mac'): continue
+    if d == ios_sources: continue
+    if s == os.path.join(host, 'main.c'): place(s, f'{gen}/main/main.c'); continue
+    flat = os.path.relpath(s, os.path.dirname(host)).replace(os.sep, '__').replace('/', '__')
+    place(s, f'{gen}/src/{flat}')
+# paths with / on every platform: the xcconfig is read with shlex, which takes Windows' \ for escapes (clang accepts / on Windows)
+print('HEADER_SEARCH_PATHS = $(inherited) ' + ' '.join(f'"{d}"'.replace(os.sep, '/') for d in incs + dirs))
+print('OTHER_CFLAGS = $(inherited) ' + ' '.join(defs))
+print('DM_FRAMEWORKS = ' + ' '.join(f'-framework {f}' for f in fws if f != 'Cocoa'))
