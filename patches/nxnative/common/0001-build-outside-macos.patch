+// Whether iOS lets this app use the local network: there is no call that says, so a Bonjour browse for local play's type tells. While the question has not been
+// answered the browse is ready (shown as allowed); a "no", now or before, makes it wait with Bonjour's policy denied (-65570). In LiveContainer the answer is LiveContainer's
+private final class LocalNetworkCheck: ObservableObject {
+    enum State { case checking, allowed, blocked }
+    @Published var state: State = .checking
+    private var browser: NWBrowser?
+    func start() {
+        guard browser == nil else { return }
+        let b = NWBrowser(for: .bonjour(type: "_presence._tcp", domain: nil), using: NWParameters())
+        b.stateUpdateHandler = { [weak self] st in
+            DispatchQueue.main.async {
+                guard let self else { return }
+                switch st {
+                case .ready: if self.state == .checking { self.state = .allowed }
+                case .waiting(let e), .failed(let e):
+                    if case .dns(let code) = e, code == -65570 { self.state = .blocked; fputs("launcher: Local Network access is off for this app\n", stderr) }
+                default: break
+                }
+            }
+        }
+        b.start(queue: .main)
+        browser = b
+    }
+    func stop() { browser?.cancel(); browser = nil; state = .checking }
+}
