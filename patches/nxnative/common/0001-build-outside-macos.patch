+#!/usr/bin/env python3
+# build_ipa.sh's IPA path without bash, make or Xcode (Linux, Windows): the same steps, inputs (environment) and step lines (the NSP script's progress
+# reads "generate Gen/", "xcodebuild", "pack IPA"). Gen/ comes from gen_build_portable.py, the app from build_app_linux.py (clang + ld64.lld against the
+# iPhoneOS SDK), the archive from pack_ipa.py. The app icon goes to build_app_linux.py as DM_ICON (no actool). --prepare-xcode needs Xcode: use build_ipa.sh on a Mac.
+# Usage: build_ipa_portable.py [output.ipa]   Environment: as build_ipa.sh (GAME, W, PATCHED, ROMFS, MSL_IOS, AOC, GFXAPI, DM_DISPLAY_NAME, DM_BUNDLE_ID,
+#   DM_APP_VERSION, DM_SHOW_FPS, DM_LANG, DM_ICON, DM_ENV_FILE, STD_FONT, LETTER_FONT, FONT_PY)
+import glob, os, shutil, subprocess, sys, time
+
+IOS = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), '..'))
+DM = os.path.dirname(IOS)
+PY = sys.executable
+env = os.environ
+
+
+def t(msg):
+    print(f'[{time.strftime("%H:%M:%S")}] {msg}', flush=True)
+
+
+def die(msg):
+    t(f'FAIL: {msg}')
+    sys.exit(1)
+
+
+def out(*cmd, what):
+    r = subprocess.run(cmd, capture_output=True, text=True)
+    if r.returncode: die(f'{what}: {r.stderr.strip()[-500:]}')
+    return r.stdout.strip()
+
+
+if sys.argv[1:2] == ['--prepare-xcode']: die('--prepare-xcode needs Xcode (macOS): use build_ipa.sh there')
+game = env.get('GAME') or die('GAME is not set: GAME=<base game title ID>')
+games_py = os.path.join(DM, 'games', 'game.py')
+gd = out(PY, games_py, 'dir', game, what=f'no game profile {game}')
+if not os.path.isfile(os.path.join(gd, 'game.tsv')): die(f'no game profile {gd}/game.tsv')
+gp = lambda key: out(PY, games_py, game, key, what=f'game profile {gd}: {key}')
+w = env.get('W') or die('W is not set: W=<the game\'s work folder>')
+pkg = gp('package')
+patched = env.get('PATCHED') or os.path.join(w, 'build', f'patched_{pkg}')
+romfs = env.get('ROMFS') or os.path.join(w, 'data', pkg, 'RomFS')
+msl_ios = env.get('MSL_IOS') or os.path.join(w, 'build', 'ios', 'dmsh_b')
+aoc = env['AOC'] if 'AOC' in env else os.path.join(w, 'data', 'aoc')
+out_ipa = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(w), gp('ipa'))
+o = os.path.join(w, 'build', 'ios', 'pkg'); dd = os.path.join(o, 'dd')
+mods = gp('modules').split(); marker = gp('romfs_marker')
+nacp = os.path.join(w, 'data', 'v0', 'control.nacp')
+if not os.path.isfile(nacp): nacp = os.path.join(os.path.dirname(romfs), 'control.nacp')
+nacp_py = os.path.join(DM, 'tools', 'nacp.py')
+name = env.get('DM_DISPLAY_NAME') or out(PY, nacp_py, nacp, what=f'no game name in {nacp} (re-extract with nx_extract, or set DM_DISPLAY_NAME)')
+vnacp = os.path.join(os.path.dirname(romfs), 'control.nacp')
+if not os.path.isfile(vnacp): vnacp = os.path.join(w, 'data', 'v0', 'control.nacp')
+version = env.get('DM_APP_VERSION')
+if not version:
+    r = subprocess.run([PY, nacp_py, '--version', vnacp], capture_output=True, text=True)
+    version = r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else '1.0'
+    if r.returncode: t(f'no display version in {vnacp}: the app version is 1.0')
+child = dict(env, LC_ALL='C', DM_BUNDLE_ID=env.get('DM_BUNDLE_ID') or f'org.nxnative.{game.lower()}', DM_DISPLAY_NAME=name, DM_APP_VERSION=version,
+             DM_APP_CATEGORY=gp('app_category'), DM_TEAM_ID=env.get('DM_TEAM_ID') or '0000000000', DM_SHOW_FPS='YES' if env.get('DM_SHOW_FPS') == '1' else 'NO',
+             DM_LANG=env.get('DM_LANG') or 'en-US', DM_SCHEME_NAME='DmIOS', GAME=game)
+for m in mods:
+    if not (os.path.isfile(os.path.join(patched, f'{m}.patched.bin')) and os.path.isfile(os.path.join(patched, f'{m}.fixups.tsv'))):
+        die(f'no rewritten module {patched}/{m} (run dm/tools/patch_nso.py first)')
