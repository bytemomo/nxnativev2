+# passes that on. The same bytes are written here, without starting the stand-in twice per library (133 ms a start: 3,374 s of Echoes of Wisdom's 9,799 shaders)
+DEFER_MAGIC = b'//DMMSL1 deferred: compiled on the device\n'   # dm/linux/bin/xcrun's
+
