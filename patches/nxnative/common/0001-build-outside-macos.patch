+// Shaders on device: a build that left the shaders' compile to the device (DM_XCRUN_DEFER) has them compiled here, before the game, on every core (nxnativev2's
+// runtime/shaders/prepare.m), so the game finds them in Metal's cache instead of stuttering at each first use. Play never waits: pressed early, the rest goes on in the background; once per set of shaders, iOS version and GPU
+@_silgen_name("dm_shaders_to_prepare") private func dmShadersToPrepare(_ dir: UnsafePointer<CChar>) -> Int32
+@_silgen_name("dm_shaders_prepare") private func dmShadersPrepare(_ dir: UnsafePointer<CChar>, _ progress: @convention(c) (Int32, Int32, UnsafeMutableRawPointer?) -> Void,
+                                                                   _ ctx: UnsafeMutableRawPointer?) -> Int32
+@_silgen_name("dm_shaders_background") private func dmShadersBackground(_ on: Int32)
+private final class ShaderPrep: ObservableObject {
+    @Published var total = 0
+    @Published var done = 0
+    @Published var ready = false
+    // Play before it ends: the rest compiles in the background during the game (prepare.m dm_shaders_background)
+    func playing() { if !ready { dmShadersBackground(1); fputs("launcher: playing while \(total - done) shaders compile in the background\n", stderr) } }
+    private var started: Date?
+    var active: Bool { started != nil && !ready }
+    // The host's shader folder: DM_MSL_DIR (main.m) and its b-<chain version> folder, the only one an IPA has
+    private static func folder() -> String? {
+        guard let p = getenv("DM_MSL_DIR") else { return nil }
+        let msl = String(cString: p)
+        let dirs = (try? FileManager.default.contentsOfDirectory(atPath: msl))?.filter { $0.hasPrefix("b-") }.sorted() ?? []
+        return dirs.last.map { msl + "/" + $0 }
+    }
+    func start() {
+        guard started == nil else { return }
+        started = Date()
+        guard let dir = Self.folder() else {
+            fputs("launcher: shaders: no shader folder (DM_MSL_DIR \(getenv("DM_MSL_DIR").map { String(cString: $0) } ?? "unset")): nothing to prepare\n", stderr)
+            ready = true; return
+        }
+        DispatchQueue.global(qos: .userInitiated).async {
+            let n = Int(dmShadersToPrepare(dir))
+            fputs("launcher: shaders: \(n) to compile before the game (\(dir))\n", stderr)
+            DispatchQueue.main.async { self.total = n; if n == 0 { self.ready = true } }
+            guard n > 0 else { return }
+            let me = Unmanaged.passRetained(self)
+            let failed = dmShadersPrepare(dir, { done, total, ctx in
+                let p = Unmanaged<ShaderPrep>.fromOpaque(ctx!).takeUnretainedValue()
+                DispatchQueue.main.async { p.done = Int(done); p.total = Int(total) }
+            }, me.toOpaque())
+            me.release()
+            DispatchQueue.main.async { self.done = self.total; self.ready = true }
+            fputs("launcher: shaders ready (\(failed) failed)\n", stderr)
+        }
+    }
+    // "about 3 min left", from the pace so far
+    var remaining: String {
+        guard let s = started, done > 0, total > done else { return "" }
+        let left = Date().timeIntervalSince(s) / Double(done) * Double(total - done)
+        return left < 60 ? "less than a minute left" : "about \(Int((left / 60).rounded(.up))) min left"
+    }
+}
