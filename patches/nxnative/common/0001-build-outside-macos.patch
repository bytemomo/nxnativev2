+// Lines of views, each line centred (the chips under the game's name). Written as plain loops with explicit types: Xcode's Swift compiler
+// gave up type-checking the chained map / reduce form in reasonable time
+private struct Flow: Layout {
+    var spacing: CGFloat = 8
+    private struct Item { let index: Int; let size: CGSize }
+    private func lines(_ width: CGFloat, _ subviews: Subviews) -> [[Item]] {
+        var out: [[Item]] = [[]]
+        var x: CGFloat = 0
+        for (i, v) in subviews.enumerated() {
+            let s: CGSize = v.sizeThatFits(.unspecified)
+            if x > 0 && x + s.width > width {
+                out.append([])
+                x = 0
+            }
+            out[out.count - 1].append(Item(index: i, size: s))
+            x += s.width + spacing
+        }
+        return out
+    }
+    private func lineWidth(_ line: [Item]) -> CGFloat {
+        var w: CGFloat = 0
+        for item in line { w += item.size.width }
+        let gaps: CGFloat = CGFloat(max(line.count - 1, 0))
+        return w + spacing * gaps
+    }
+    private func lineHeight(_ line: [Item]) -> CGFloat {
+        var h: CGFloat = 0
+        for item in line { h = max(h, item.size.height) }
+        return h
+    }
+    func sizeThatFits(proposal: ProposedViewSize, subviews: Subviews, cache: inout ()) -> CGSize {
+        let available: CGFloat = proposal.width ?? .infinity
+        let all: [[Item]] = lines(available, subviews)
+        var width: CGFloat = 0
+        var height: CGFloat = 0
+        for line in all {
+            width = max(width, lineWidth(line))
+            height += lineHeight(line)
+        }
+        let gaps: CGFloat = CGFloat(max(all.count - 1, 0))
+        height += spacing * gaps
+        return CGSize(width: min(width, available), height: height)
+    }
+    func placeSubviews(in b: CGRect, proposal: ProposedViewSize, subviews: Subviews, cache: inout ()) {
+        var y: CGFloat = b.minY
+        for line in lines(b.width, subviews) {
+            let lw: CGFloat = lineWidth(line)
+            let lh: CGFloat = lineHeight(line)
+            var x: CGFloat = b.minX + (b.width - lw) / 2
+            for item in line {
+                let top: CGFloat = y + (lh - item.size.height) / 2
+                subviews[item.index].place(at: CGPoint(x: x, y: top), proposal: ProposedViewSize(item.size))
+                x += item.size.width + spacing
+            }
+            y += lh + spacing
+        }
+    }
+}
