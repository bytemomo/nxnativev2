+    if os.environ.get('DM_XCRUN_DEFER') and sys.platform != 'darwin':
+        with open(msl, 'rb') as f: src = f.read()
+        body = DEFER_MAGIC + ('//DMMSL-REQUEST ' + '\t'.join(['iphoneos', *METAL[METAL.index('metal') + 1:]]) + '\n').encode() + src
+        for p in (air, lib):
