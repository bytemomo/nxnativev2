+gfx = env.get('GFXAPI') or ('nvn' if has_libs(os.path.join(msl_ios, f'b-{chain}')) else 'vulkan' if os.path.isfile(os.path.join(msl_ios, 'vk', 'vk_shaders.metallib'))
