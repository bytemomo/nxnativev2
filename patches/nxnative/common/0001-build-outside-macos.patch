+if gfx == 'nvn' and os.path.isfile(os.path.join(gd, 'cb_extent.tsv')): shutil.copy(os.path.join(gd, 'cb_extent.tsv'), os.path.join(gen, 'dm'))
+# the launcher's settings (Launcher.swift), when this nxnative has them
+settings_py = os.path.join(DM, 'games', 'settings.py')
+if os.path.isfile(settings_py):
+    launcher = out(PY, settings_py, game, patched, vnacp, os.path.join(gen, 'dm', 'launcher.json'), what='launcher settings (dm/games/settings.py)')
+    t(f'launcher: {launcher}')
+if env.get('DM_ENV_FILE'):
