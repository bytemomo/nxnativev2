+                  '/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', os.path.join(windir, 'Fonts', 'arial.ttf'), '/System/Library/Fonts/Supplemental/Arial Unicode.ttf']
+letter_candidates = ['/usr/share/fonts/noto/NotoSans-Bold.ttf', '/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf', '/usr/share/fonts/TTF/DejaVuSans-Bold.ttf',
+                     '/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf', os.path.join(windir, 'Fonts', 'arialbd.ttf')]
+std_font = env.get('STD_FONT') or next((c for c in std_candidates if os.path.isfile(c)), None) or die('no standard font found (STD_FONT=a TTF)')
+letter_font = env.get('LETTER_FONT') or next((c for c in letter_candidates if os.path.isfile(c)), None)
+os.makedirs(os.path.join(gen, 'dm', 'font'))
+shutil.copy(std_font, os.path.join(gen, 'dm', 'font', 'standard.ttf'))
+r = subprocess.run([env.get('FONT_PY') or PY, os.path.join(DM, 'tools', 'make_ext_font.py'), os.path.join(gen, 'dm', 'font', 'nintendo_ext.ttf')] + ([letter_font] if letter_font else []),
+                   capture_output=True, text=True)
+if r.returncode: die(f'make_ext_font.py: {r.stderr.strip()[-500:]}')
+
+icon = env.get('DM_ICON') or os.path.join(os.path.dirname(romfs), 'icon.jpg')
+if os.path.isfile(icon):
+    child['DM_ICON'] = icon
+    t(f'app icon: {icon}')
+else:
+    t(f'no app icon ({icon} not found): the home-screen icon stays blank')
+
+os.makedirs(o, exist_ok=True)
+t('xcodebuild stand-in: tools/build_app_linux.py (clang + ld64.lld, Release, unsigned, iPhone + iPad)')
+app = os.path.join(dd, 'Build', 'Products', 'Release-iphoneos', 'DmIOS.app')
+with open(os.path.join(o, 'build.log'), 'w') as log:
+    r = subprocess.run([env.get('FONT_PY') or PY, os.path.join(IOS, 'tools', 'build_app_linux.py'), IOS, app, os.path.join(dd, 'Build', 'Intermediates.noindex', 'obj')],
+                       stdout=log, stderr=subprocess.STDOUT, env=child)
+if r.returncode:
+    for line in open(os.path.join(o, 'build.log'), errors='replace'):
