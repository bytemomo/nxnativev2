+#!/usr/bin/env python3
+# The unsigned DmIOS.app on Linux, where there is no Xcode: what xcodebuild makes of project.yml (Release, iPhone + iPad), with clang and ld64.lld against the iOS SDK that xtool installs
+# from Xcode.xip (xtool sdk install <Xcode.xip>; dm/linux/README.md). build_ipa.sh calls it after generating Gen/ (gen_build.py, gen_embed.py), instead of xcodegen and xcodebuild.
+#   The compile flags are the project's (project.yml settings and xcodegen's presets: -Os, ARC for Objective-C, gnu11, modules, -mcpu=apple-a18, warnings off) plus Gen/dm.xcconfig's;
+#   Info.plist holds project.yml's info properties and the keys Xcode adds; the app icon is PNG files named in Info.plist (CFBundleIcons) in place of an asset catalog, which needs actool.
+#   Each compile writes a "CompileC <source>" line and the link an "Ld" line to stdout, as xcodebuild's log does (the NSP script counts them).
+# Usage: build_app_linux.py <dm/ios or the project folder holding Gen/ and Sources/> <output DmIOS.app> <objects folder>; build_app_linux.py --find-sdk prints the SDK it would use
+#   Environment: DM_BUNDLE_ID, DM_DISPLAY_NAME, DM_APP_VERSION, DM_APP_CATEGORY, DM_SHOW_FPS (YES / NO), DM_LANG (set by build_ipa.sh); DM_ICON = the icon image (optional, needs Pillow);
+#   DM_IOS_SDK = the iPhoneOS SDK folder (default: the one in xtool's Darwin Swift SDK); J = parallel compiles
+#   Swift sources (Sources/*.swift, e.g. Launcher.swift) are compiled by swiftc into one object (module DmIOS) against the SDK and Xcode's Swift resource
+#   folder (the toolchain's usr/lib/swift: its iphoneos part, apinotes and clang headers; the SDK's Swift interfaces need it, a Linux toolchain's own does not fit):
+#   DM_SWIFT_RESOURCES = that folder (default: <SDK>/../swift-resources, else the one in xtool's Darwin Swift SDK); DM_SWIFT_OBJECT = the Swift sources compiled
+#   ahead of time into that one object (an arm64 iOS object, the same on every computer: a packaged build ships it, and needs no swiftc)
+import concurrent.futures as cf, glob, hashlib, os, plistlib, re, shlex, shutil, subprocess, sys
+
+MIN_IOS = '26.0'   # project.yml deploymentTarget (Metal 4)
+ARCH_FLAGS = ['-target', f'arm64-apple-ios{MIN_IOS}', '-mcpu=apple-a18']   # project.yml OTHER_CFLAGS: the host assembly has LSE atomics
+# diagnostics that upstream clang makes errors and Xcode's clang still reports as warnings (which the project turns off): the sources build as they do in Xcode
+COMPAT = ['-Wno-error=incompatible-pointer-types']
+# UIKit side of the app (Sources/) and what the host's sources import beyond dm/host/Makefile's frameworks (its Mac list has Cocoa, which gen_build.py leaves out)
+APP_FRAMEWORKS = ['UIKit', 'Foundation', 'CoreGraphics', 'CoreText', 'CoreMotion', 'CoreFoundation', 'AVFAudio', 'AVFoundation']
+
+
+def die(msg):
+    sys.exit(f'[RED] build_app_linux: {msg}')
+
+
+def find_sdk():
+    if os.environ.get('DM_IOS_SDK'): return os.environ['DM_IOS_SDK']
+    home = os.path.expanduser('~')
+    pats = [f'{home}/.swiftpm/swift-sdks/darwin.artifactbundle/**/iPhoneOS*.sdk', f'{home}/.xtool/**/iPhoneOS*.sdk', f'{home}/.local/share/xtool/**/iPhoneOS*.sdk',
+            f'{home}/.config/swiftpm/swift-sdks/**/iPhoneOS*.sdk']
+    for p in pats:
+        hits = sorted(h for h in glob.glob(p, recursive=True) if os.path.isfile(os.path.join(h, 'SDKSettings.json')))
+        if hits: return hits[-1]
+    die('no iPhoneOS SDK: install xtool\'s Darwin SDK from Xcode 26 (xtool sdk install <Xcode.xip>), or set DM_IOS_SDK to an iPhoneOS.sdk folder')
+
+
+def find_swift_resources(sdk):
+    if os.environ.get('DM_SWIFT_RESOURCES'): return os.environ['DM_SWIFT_RESOURCES']
+    beside = os.path.join(os.path.dirname(os.path.realpath(sdk)), 'swift-resources')
+    if os.path.isdir(os.path.join(beside, 'iphoneos')): return beside
+    xt = os.path.expanduser('~/.config/swiftpm/swift-sdks/darwin.artifactbundle/Developer/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift')
+    if os.path.isdir(os.path.join(xt, 'iphoneos')): return xt
+    die('Swift sources need Xcode\'s Swift resource folder (the toolchain\'s usr/lib/swift): set DM_SWIFT_RESOURCES')
+
+
+def compile_swift(proj, sdk, obj):
+    """The app's Swift sources as one object (whole module), or None without any"""
+    files = sorted(os.path.join(proj, 'Sources', f) for f in os.listdir(os.path.join(proj, 'Sources')) if f.endswith('.swift'))
+    if not files: return None
+    if os.environ.get('DM_SWIFT_OBJECT'):
+        if not os.path.isfile(os.environ['DM_SWIFT_OBJECT']): die(f'no prebuilt Swift object at {os.environ["DM_SWIFT_OBJECT"]}')
+        print('CompileSwift (prebuilt) ' + os.environ['DM_SWIFT_OBJECT'], flush=True)
+        return os.environ['DM_SWIFT_OBJECT']
+    if not shutil.which('swiftc'): die('the app has Swift sources and no swiftc was found: install Swift (swift.org)')
+    o = os.path.join(obj, 'swift_DmIOS.o')
+    print('CompileSwift ' + ' '.join(os.path.basename(f) for f in files), flush=True)
+    cmd = ['swiftc', '-target', f'arm64-apple-ios{MIN_IOS}', '-sdk', sdk, '-resource-dir', find_swift_resources(sdk), '-Xfrontend', '-enable-cross-import-overlays',
+           '-parse-as-library', '-module-name', 'DmIOS', '-O', '-wmo', '-c', *files, '-o', o]
+    r = subprocess.run(cmd, capture_output=True, text=True)
+    if r.returncode: print(r.stdout + r.stderr, flush=True); die('Swift compile failed')
+    return o
+
+
+def sdk_version(sdk):
+    try:
+        import json
+        return json.load(open(os.path.join(sdk, 'SDKSettings.json'))).get('Version', '')
+    except (OSError, ValueError): return ''
+
+
+def xcconfig(path):   # Gen/dm.xcconfig: NAME = value lines, the value's $(inherited) dropped; a repeated name adds to the earlier value (as build_ipa.sh's appended OTHER_LDFLAGS)
+    v = {}
+    for ln in open(path):
+        m = re.match(r'\s*([A-Z_]+)\s*=\s*(.*)$', ln.rstrip('\n'))
+        if m: v[m.group(1)] = (v.get(m.group(1), '') + ' ' + m.group(2).replace('$(inherited)', '')).strip()
+    for k in v: v[k] = re.sub(r'\$\((\w+)\)', lambda m: v.get(m.group(1), ''), v[k])
+    return v
+
+
+def info_plist(sdk):
+    e = os.environ
+    p = {
+        'CFBundleDevelopmentRegion': 'en', 'CFBundleExecutable': 'DmIOS', 'CFBundleIdentifier': e['DM_BUNDLE_ID'], 'CFBundleInfoDictionaryVersion': '6.0',
+        'CFBundleName': 'DmIOS', 'CFBundlePackageType': 'APPL', 'CFBundleSupportedPlatforms': ['iPhoneOS'], 'MinimumOSVersion': MIN_IOS, 'UIDeviceFamily': [1, 2],
+        'DTPlatformName': 'iphoneos', 'DTSDKName': 'iphoneos' + sdk_version(sdk), 'DTPlatformVersion': sdk_version(sdk), 'UIRequiredDeviceCapabilities': ['arm64'],
+        # project.yml info properties
+        'CFBundleDisplayName': e['DM_DISPLAY_NAME'], 'CFBundleVersion': e['DM_APP_VERSION'], 'CFBundleShortVersionString': e['DM_APP_VERSION'],
+        'UILaunchStoryboardName': '', 'UIFileSharingEnabled': True, 'LSSupportsOpeningDocumentsInPlace': True,
+        'UISupportedInterfaceOrientations': ['UIInterfaceOrientationLandscapeRight', 'UIInterfaceOrientationLandscapeLeft'],
+        'UIRequiresFullScreen': True, 'UIStatusBarHidden': True, 'UIViewControllerBasedStatusBarAppearance': False, 'LSApplicationCategoryType': e.get('DM_APP_CATEGORY', ''),
+        'DMShowFPS': e.get('DM_SHOW_FPS', 'NO'), 'DMLanguage': e.get('DM_LANG', 'en-US'), 'LSSupportsGameMode': True, 'GCSupportsControllerUserInteraction': True,
+        'GCSupportedGameControllers': [{'ProfileName': 'ExtendedGamepad'}], 'CADisableMinimumFrameDurationOnPhone': True,
+        'NSLocalNetworkUsageDescription': 'Finds nearby players for local play.', 'NSBonjourServices': ['_presence._tcp'],   # local play (dm/rt/lan)
+        'UIApplicationSceneManifest': {'UIApplicationSupportsMultipleScenes': False, 'UISceneConfigurations': {'UIWindowSceneSessionRoleApplication': [
+            {'UISceneConfigurationName': 'Default', 'UISceneDelegateClassName': 'SceneDelegate'}]}},
+    }
+    return p
+
+
+ICONS = (('AppIcon60x60', 120, '@2x', ''), ('AppIcon60x60', 180, '@3x', ''), ('AppIcon76x76', 152, '@2x', '~ipad'), ('AppIcon83.5x83.5', 167, '@2x', '~ipad'))
+
+
+def icons(app, plist):   # PNG icons beside the executable, named in CFBundleIcons / CFBundleIcons~ipad (actool's output without the asset catalog)
+    src = os.environ.get('DM_ICON')
+    if not src or not os.path.isfile(src): return
+    from PIL import Image
+    im = Image.open(src).convert('RGB')
+    for base, px, scale, dev in ICONS: im.resize((px, px), Image.LANCZOS).save(os.path.join(app, f'{base}{scale}{dev}.png'))
+    plist['CFBundleIcons'] = {'CFBundlePrimaryIcon': {'CFBundleIconFiles': ['AppIcon60x60'], 'CFBundleIconName': 'AppIcon'}}
+    plist['CFBundleIcons~ipad'] = {'CFBundlePrimaryIcon': {'CFBundleIconFiles': ['AppIcon60x60', 'AppIcon76x76', 'AppIcon83.5x83.5'], 'CFBundleIconName': 'AppIcon'}}
+
+
+def main():
+    if sys.argv[1:] == ['--find-sdk']: print(find_sdk()); return
+    proj, app, obj = (os.path.abspath(a) for a in sys.argv[1:4])
+    sdk = find_sdk(); gen = os.path.join(proj, 'Gen')
+    xc = xcconfig(os.path.join(gen, 'dm.xcconfig'))
+    incs = [f'-I{d}' for d in shlex.split(xc.get('HEADER_SEARCH_PATHS', ''))]
+    defs = shlex.split(xc.get('OTHER_CFLAGS', ''))
+    ldflags = shlex.split(xc.get('OTHER_LDFLAGS', ''))   # DM_FRAMEWORKS and gen_embed.py's -segprot flags
+    srcs = [(os.path.join(gen, 'src', f), []) for f in sorted(os.listdir(os.path.join(gen, 'src')))]
+    srcs += [(os.path.join(gen, 'main/main.c'), ['-Dmain=dm_main']), (os.path.join(gen, 'embed.S'), [])]
+    srcs += [(os.path.join(proj, 'Sources', f), []) for f in sorted(os.listdir(os.path.join(proj, 'Sources'))) if f.endswith(('.c', '.m', '.S'))]
+    base = ['clang', *ARCH_FLAGS, '-isysroot', sdk, '-Os', '-g0', '-w', *COMPAT, *defs, *incs, f'-I{os.path.join(proj, "Sources")}']
+    os.makedirs(obj, exist_ok=True)
+
+    def compile_one(item):
+        src, extra = item
+        real = os.path.realpath(src); ext = os.path.splitext(real)[1]
+        lang = {'.m': ['-x', 'objective-c', '-std=gnu11', '-fmodules', '-fobjc-arc'], '.c': ['-x', 'c', '-std=gnu11', '-fmodules'], '.S': ['-x', 'assembler-with-cpp']}[ext]
+        o = os.path.join(obj, hashlib.sha1(src.encode()).hexdigest()[:12] + '_' + os.path.basename(src) + '.o')
+        cmd = [*base, *lang, *extra, '-c', src, '-o', o]
+        print(f'CompileC {src}', flush=True)
+        r = subprocess.run(cmd, capture_output=True, text=True)
+        if r.returncode: return src, r.stderr[-4000:] or r.stdout[-4000:], o
+        return src, None, o
+
+    with cf.ThreadPoolExecutor(int(os.environ.get('J') or os.cpu_count() or 8)) as ex:
+        res = list(ex.map(compile_one, srcs))
+    bad = [(s, e) for s, e, _ in res if e]
+    for s, e in bad: print(f'error: {s}\n{e}', flush=True)
+    if bad: die(f'{len(bad)} of {len(srcs)} files failed to compile')
+
+    swift_o = compile_swift(proj, sdk, obj)
+    swift_link = [swift_o, '-L' + os.path.join(sdk, 'usr/lib/swift'), '-L' + os.path.join(find_swift_resources(sdk), 'iphoneos')] if swift_o else []
+    # clang's runtime for iOS, which Xcode links into every app (__isPlatformVersionAtLeast for #available / @available); a Linux clang has none
+    rt = os.path.join(find_swift_resources(sdk), 'clang/lib/darwin/libclang_rt.ios.a') if swift_o else ''
+    if rt and os.path.isfile(rt): swift_link.append(rt)
+
+    shutil.rmtree(app, ignore_errors=True); os.makedirs(app)
+    print('Ld DmIOS', flush=True)
+    fws = [x for f in APP_FRAMEWORKS for x in ('-framework', f)]
+    # no -dead_strip: ld64.lld drops sections nothing refers to by symbol, which Apple's ld64 keeps: the embedded modules (gen_embed.py, found by getsectiondata in loader.c)
+    cmd = ['clang', *ARCH_FLAGS, '-isysroot', sdk, '-fuse-ld=lld', '-o', os.path.join(app, 'DmIOS'), *[o for _, _, o in res], *swift_link, *ldflags, *fws]
+    r = subprocess.run(cmd, capture_output=True, text=True)
+    if r.returncode: print(r.stdout + r.stderr, flush=True); die('link failed')
+
+    print('CpResource Gen/dm', flush=True)
+    shutil.copytree(os.path.join(gen, 'dm'), os.path.join(app, 'dm'), symlinks=False)
+    print('ProcessInfoPlistFile Info.plist', flush=True)
+    plist = info_plist(sdk); icons(app, plist)
+    with open(os.path.join(app, 'Info.plist'), 'wb') as f: plistlib.dump(plist, f, fmt=plistlib.FMT_BINARY)
+    open(os.path.join(app, 'PkgInfo'), 'w').write('APPL????')
+    print(f'app: {app}', flush=True)
+
+
+if __name__ == '__main__':
+    main()
