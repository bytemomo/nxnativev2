+class OffMac(unittest.TestCase):
+    """Linux and Windows: SPIRV-Cross built there from the pinned release and Apple's Metal Developer Tools for Windows never match the lock; both go on with the note line,
+    while a missing tool or another translator still fails"""
+    def check(self, bad):
