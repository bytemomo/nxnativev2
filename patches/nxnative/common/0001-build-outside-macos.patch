+if gfx == 'vulkan' and not os.path.isfile(os.path.join(msl_ios, 'vk', 'vk_shaders.metallib')): die(f'no iOS Vulkan shader library {msl_ios}/vk')
+elif gfx == 'gl' and not os.path.isfile(os.path.join(msl_ios, 'gl', 'gl_shaders.metallib')): die(f'no iOS GL shader library {msl_ios}/gl')
+elif gfx == 'nvn' and not (chain and has_libs(os.path.join(msl_ios, f'b-{chain}'))): die(f'no iOS shader libraries {msl_ios}/b-{chain}')
+
+t(f'app: {name} {version} ({child["DM_BUNDLE_ID"]}), language {child["DM_LANG"]}' + (', frame-rate counter on' if child['DM_SHOW_FPS'] == 'YES' else ''))
+t('generate Gen/ (host sources, embedded modules, tables)')
+gen = os.path.join(IOS, 'Gen')
+shutil.rmtree(gen, ignore_errors=True); os.makedirs(os.path.join(gen, 'dm'))
+r = subprocess.run([PY, os.path.join(IOS, 'tools', 'gen_build_portable.py'), os.path.join(DM, 'host'), gen], capture_output=True, text=True, env=child)
+if r.returncode: die(f'gen_build_portable: {r.stderr.strip()[-800:]}')
+xc = r.stdout
+f = out(PY, os.path.join(IOS, 'tools', 'gen_embed.py'), patched, os.path.join(gen, 'embed.S'), *mods, what='gen_embed')
+with open(os.path.join(gen, 'dm.xcconfig'), 'w') as x:
+    x.write(xc.rstrip('\n') + '\n' + f'OTHER_LDFLAGS = $(inherited) $(DM_FRAMEWORKS) {f}\n')
+for pat in ('*.fixups.tsv', '*.gates.tsv', '*.cuts.tsv', '*.obs.tsv'):
+    for p in glob.glob(os.path.join(patched, pat)): shutil.copy(p, os.path.join(gen, 'dm'))
+tables = ['shader_map.tsv', 'pso_manifest.tsv'] + ([] if gfx in ('vulkan', 'gl') else ['c1_full.tsv'])
