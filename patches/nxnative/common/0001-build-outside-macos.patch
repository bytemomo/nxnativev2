@@ -0,0 +1,188 @@
+#!/usr/bin/env python3
+# build_ipa.sh's IPA path without bash, make or Xcode (Linux, Windows): the same steps, inputs (environment) and step lines (the NSP script's progress
+# reads "generate Gen/", "xcodebuild", "pack IPA"). Gen/ comes from gen_build_portable.py, the app from build_app_linux.py (clang + ld64.lld against the
+# iPhoneOS SDK), the archive from pack_ipa.py. The app icon goes to build_app_linux.py as DM_ICON (no actool). --prepare-xcode needs Xcode: use build_ipa.sh on a Mac.
+# Usage: build_ipa_portable.py [output.ipa]   Environment: as build_ipa.sh (GAME, W, PATCHED, ROMFS, MSL_IOS, AOC, GFXAPI, DM_DISPLAY_NAME, DM_BUNDLE_ID,
+#   DM_APP_VERSION, DM_SHOW_FPS, DM_LANG, DM_ICON, DM_ENV_FILE, DM_COPY_ROMFS, IOS_PULL, STD_FONT, LETTER_FONT, FONT_PY)
+# Not here (macOS tools): the offline pipeline archive (pso_offline.py, metal-tt: the device builds the pipelines on its first start instead) and the unsigned IPA's
+# ad-hoc signature with the Increased Memory Limit entitlement (codesign: the install tool's signature carries the entitlements it is given)
+import glob, os, shutil, subprocess, sys, time
+
+IOS = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), '..'))
+DM = os.path.dirname(IOS)
+PY = sys.executable
+env = os.environ
+
+
+def t(msg):
+    print(f'[{time.strftime("%H:%M:%S")}] {msg}', flush=True)
+
+
+def die(msg):
+    t(f'FAIL: {msg}')
+    sys.exit(1)
+
+
+def out(*cmd, what):
+    r = subprocess.run(cmd, capture_output=True, text=True)
+    if r.returncode: die(f'{what}: {r.stderr.strip()[-500:]}')
+    return r.stdout.strip()
+
+
+if sys.argv[1:2] == ['--prepare-xcode']: die('--prepare-xcode needs Xcode (macOS): use build_ipa.sh there')
+game = env.get('GAME') or die('GAME is not set: GAME=<base game title ID>')
+games_py = os.path.join(DM, 'games', 'game.py')
+gd = out(PY, games_py, 'dir', game, what=f'no game profile {game}')
+if not os.path.isfile(os.path.join(gd, 'game.tsv')): die(f'no game profile {gd}/game.tsv')
+gp = lambda key: out(PY, games_py, game, key, what=f'game profile {gd}: {key}')
+w = env.get('W') or die('W is not set: W=<the game\'s work folder>')
+pkg = gp('package')
+patched = env.get('PATCHED') or os.path.join(w, 'build', f'patched_{pkg}')
+romfs = env.get('ROMFS') or next((p for p in (os.path.join(w, 'data', pkg, 'RomFS.img'),) if os.path.isfile(p)), os.path.join(w, 'data', pkg, 'RomFS'))   # an image or a folder
+msl_ios = env.get('MSL_IOS') or os.path.join(w, 'build', 'ios', 'dmsh_b')
+aoc = env['AOC'] if 'AOC' in env else os.path.join(w, 'data', 'aoc')
+out_ipa = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(w), gp('ipa'))
+o = os.path.join(w, 'build', 'ios', 'pkg'); dd = os.path.join(o, 'dd')
