+private struct CardRow: View {
+    let s: Setting
+    @ObservedObject var m: LauncherModel
+    private var locked: Bool { m.fixed.contains(s.env) }
+    var body: some View {
+        HStack(spacing: 12) {
+            IconTile(name: s.icon ?? "slider.horizontal.3", color: sectionTint(s.sectionTitle))
+            control.disabled(locked)
+            if !(s.help ?? "").isEmpty || locked {
+                HelpButton(title: s.label, text: [s.help ?? "", locked ? (m.fromLaunch.contains(s.env) ? "Set at launch: it is kept as it is." : "Set by an env file (the app's env.txt or a debug build): it is kept as it is.") : ""]
+                    .filter { !$0.isEmpty }.joined(separator: "\n\n"))
+            }
+        }
+    }
+    private var title: some View {
+        VStack(alignment: .leading, spacing: 2) {
+            HStack(spacing: 6) {
+                Text(s.label)
+                if locked { Image(systemName: "lock.fill").font(.caption2).foregroundStyle(.secondary) }
+            }
+            if !s.note.isEmpty { Text(s.note).font(.caption).foregroundStyle(.secondary).fixedSize(horizontal: false, vertical: true) }
+        }
+        .layoutPriority(1)
+    }
+    @ViewBuilder private var control: some View {
+        switch s.kind {
+        case "choice":
+            HStack {
+                title
+                Spacer(minLength: 8)
+                Picker(s.label, selection: m.binding(s)) { ForEach(s.options ?? [], id: \.[0]) { Text($0[1]).tag($0[0]) } }.labelsHidden().pickerStyle(.menu).tint(.primary)
+            }
+        case "range":
+            let lo = s.min ?? 0, hi = s.max ?? 1
+            let v = Binding<Double>(get: { Double(m.values[s.env] ?? s.def) ?? hi }, set: { m.values[s.env] = String(format: "%.2f", $0) })
+            VStack(alignment: .leading, spacing: 4) {
+                HStack {
+                    title
+                    Spacer()
+                    Text(m.rangeLabel(s, v.wrappedValue)).monospacedDigit().foregroundStyle(.secondary)
+                }
+                Slider(value: v, in: lo...hi, step: s.step ?? 0.05).tint(sectionTint(s.sectionTitle))
+                    .accessibilityLabel(s.label).accessibilityValue(m.rangeLabel(s, v.wrappedValue))
+            }
+        default:
+            Toggle(isOn: Binding(get: { (m.values[s.env] ?? s.def) == s.onValue }, set: { m.values[s.env] = $0 ? s.onValue : s.offValue })) { title }.tint(sectionTint(s.sectionTitle))
+        }
+    }
